generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 市场异动事件（持久化，服务重启后历史仍可查）
model AnomalyEvent {
  id             String   @id @default(cuid())
  symbol         String // 交易对，如 BTCUSDT
  baseAsset      String // 基础资产，如 BTC
  type           String // 异动类型: SPIKE_UP | SPIKE_DOWN | VOLUME_SURGE | BREAKOUT_HIGH | BREAKOUT_LOW
  severity       String   @default("MINOR") // 等级: MINOR | MAJOR
  price          Float // 触发时价格
  changePct      Float // 触发窗口内涨跌幅 %
  volumeMultiple Float    @default(0) // 成交量相对均值倍数（成交量异动专用）
  quoteVolume1m  Float    @default(0) // 触发时 1 分钟成交额（USDT）
  detail         String   @default("") // 附加说明
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([symbol, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ---------- 模拟建仓系统 ----------

// 模拟账户（余额 = 可用保证金，不含持仓占用）
model PaperAccount {
  id        String   @id @default(cuid())
  name      String   @unique // 固定 "default"
  balance   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 模拟持仓（USDT 本位，全仓保证金模式）
model PaperPosition {
  id         String    @id @default(cuid())
  accountId  String
  symbol     String
  base       String
  side       String // LONG | SHORT
  leverage   Float
  margin     Float // 初始保证金
  qty        Float // 币数量
  entryPrice Float
  liqPrice   Float // 预估强平价
  openFee    Float     @default(0)
  status     String    @default("OPEN") // OPEN | CLOSED | LIQUIDATED
  exitPrice  Float?
  pnl        Float? // 已实现毛盈亏
  closeFee   Float     @default(0)
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  @@index([accountId, status])
}

// 模拟成交流水
model PaperTrade {
  id         String   @id @default(cuid())
  accountId  String
  positionId String?
  symbol     String
  action     String // OPEN_LONG | OPEN_SHORT | CLOSE_LONG | CLOSE_SHORT | LIQUIDATE
  price      Float
  qty        Float
  fee        Float    @default(0)
  pnl        Float    @default(0) // 平仓净盈亏（扣手续费）；强平为 -margin
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

// 每日热门池（UTC+8 每日 0 点重建：成交额 Top80 + 涨幅 Top40 + 跌幅 Top40 + 放量 Top20）
model HotPoolEntry {
  id        String   @id @default(cuid())
  date      String // 日期 YYYY-MM-DD（UTC+8）
  symbol    String
  base      String
  tags      String // JSON 数组，如 ["VOL","UP"]
  rank      Int
  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date, rank])
}
