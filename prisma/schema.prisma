generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 市场异动事件（持久化，服务重启后历史仍可查）
model AnomalyEvent {
  id             String   @id @default(cuid())
  symbol         String // 交易对，如 BTCUSDT
  baseAsset      String // 基础资产，如 BTC
  type           String // 异动类型: SPIKE_UP | SPIKE_DOWN | VOLUME_SURGE | BREAKOUT_HIGH | BREAKOUT_LOW
  severity       String   @default("MINOR") // 等级: MINOR | MAJOR
  price          Float // 触发时价格
  changePct      Float // 触发窗口内涨跌幅 %
  volumeMultiple Float    @default(0) // 成交量相对均值倍数（成交量异动专用）
  quoteVolume1m  Float    @default(0) // 触发时 1 分钟成交额（USDT）
  detail         String   @default("") // 附加说明
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([symbol, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ---------- 模拟建仓系统 ----------

// 模拟账户（余额 = 可用保证金，不含持仓占用）
model PaperAccount {
  id             String   @id @default(cuid())
  name           String   @unique // 固定 "default"
  balance        Float
  totalDeposited Float    @default(0) // 累计充值（ROI 本金基数 = 初始资金 + 累计充值）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 模拟持仓（USDT 本位，全仓保证金模式）
model PaperPosition {
  id         String    @id @default(cuid())
  accountId  String
  symbol     String
  base       String
  side       String // LONG | SHORT
  leverage   Float
  margin     Float // 初始保证金
  qty        Float // 币数量
  entryPrice Float
  liqPrice   Float // 预估强平价
  openFee    Float     @default(0)
  status     String    @default("OPEN") // OPEN | CLOSED | LIQUIDATED
  exitPrice  Float?
  pnl        Float? // 已实现毛盈亏
  closeFee   Float     @default(0)
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  @@index([accountId, status])
}

// 模拟成交流水
model PaperTrade {
  id         String   @id @default(cuid())
  accountId  String
  positionId String?
  symbol     String
  action     String // OPEN_LONG | OPEN_SHORT | CLOSE_LONG | CLOSE_SHORT | LIQUIDATE
  price      Float
  qty        Float
  fee        Float    @default(0)
  pnl        Float    @default(0) // 平仓净盈亏（扣手续费）；强平为 -margin
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

// 每日热门池（UTC+8 每日 0 点重建：成交额 Top80 + 涨幅 Top40 + 跌幅 Top40 + 放量 Top20）
model HotPoolEntry {
  id        String   @id @default(cuid())
  date      String // 日期 YYYY-MM-DD（UTC+8）
  symbol    String
  base      String
  tags      String // JSON 数组，如 ["VOL","UP"]
  rank      Int
  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date, rank])
}

// ---------- 趋势跟踪（TrendWatchService，Universal Trend Engine 集成） ----------
// 只在入池/状态变化/新 K 线/生命周期变化时写入（不每轮扫描无条件落库）。
// 重启后 loadActive() 恢复候选池与每个标的的 UTE 趋势确认历史（trendStateJson）。

model TrendWatchSymbol {
  id             String   @id @default(cuid())
  symbol         String // 交易对，如 BTCUSDT
  market         String   @default("futures") // 市场标识
  interval       String   @default("1m") // K 线周期标识
  // —— 候选池生命周期 ——
  status         String   @default("WATCHING") // WATCHING=在池 | RETIRED=已退池
  addedAt        DateTime // 入池时间
  lastAnomalyAt  DateTime? // 最近一次异动时间（候选依据的事件时间）
  expiresAt      DateTime? // 候选过期时间（超过且趋势 idle → 退池）
  // —— Universal Trend Engine 状态 ——
  trendStateJson String   @default("{}") // UTE TrendState 完整 JSON（恢复确认历史用）
  lastSignalJson String? // 最近一次完整趋势信号 JSON（含 assessment 评分依据）
  lastPhase      String   @default("idle") // idle | candidate | confirmed
  lastDirection  String   @default("flat") // up | down | flat
  lastScore      Float    @default(0)
  // —— K 线状态 ——
  lastBarTime    DateTime? // 最近已参与评估的已收盘 1m K 线开盘时间
  lastKlineAt    DateTime? // 最近一次 K 线刷新时间
  // —— Task 54 v2 生命周期（结束判定/趋势周期） ——
  lifecycleStateJson String   @default("{}") // 生命周期状态机完整 JSON（END_PENDING 证据计数等）
  trendCycleId   String? // 当前趋势周期标识（symbol:方向:确认时刻）
  lastPhaseV2    String   @default("OBSERVING") // OBSERVING | CANDIDATE_* | CONFIRMED_* | END_PENDING | ENDED | DATA_UNAVAILABLE
  endReason      String? // ENDED 时的结束原因
  updatedAt      DateTime @updatedAt

  @@unique([symbol, market, interval])
  @@index([status])
  @@index([lastPhase])
}

// ---------- 趋势自动模拟交易（Task 54，账户 trend-auto-v1） ----------
// 资金账户复用 PaperAccount（name = 'trend-auto-v1'，与手动 default 完全隔离）；
// 持仓复用 PaperPosition（accountId 指向自动账户）；下表保存趋势关联与幂等决策。

// 自动交易运行配置/状态（单行，name 固定 'trend-auto-v1'）
model TrendAutoConfig {
  id             String   @id @default(cuid())
  name           String   @unique // 固定 "trend-auto-v1"
  mode           String   @default("RUNNING") // RUNNING | PAUSED | STOPPED
  initialCapital Float // 初始资金（重置时回填；界面明确展示）
  marginRatio    Float    @default(0.2) // 开仓目标保证金 = 开仓时账户权益 × 该比例
  leverage       Float    @default(20) // 固定杠杆
  maxPositions   Int      @default(4) // 最大同时持仓数
  slippageBps    Float    @default(2) // 滑点估算（基点，成交记录展示 + 净盈亏保守口径）
  peakEquity     Float    @default(0) // 历史峰值权益（当前回撤计算基准；每次巡检更新）
  updatedAt      DateTime @updatedAt
}

// 自动持仓的趋势关联元数据（positionId = PaperPosition.id，一一对应）
model TrendTradeMeta {
  positionId       String    @id
  trendCycleId     String // 开仓时的趋势周期（幂等：同周期不重复开仓）
  symbol           String
  side             String // LONG | SHORT
  trendPhaseAtOpen String // 开仓时相位（CONFIRMED_UP/DOWN）
  scoreAtOpen      Float     @default(0) // 开仓时 UTE 趋势评分
  featuresAtOpen   String    @default("{}") // 开仓时特征快照 JSON（波动率/ER/HTF/异动上下文）
  signalAtOpen     String    @default("{}") // 开仓时完整统一信号 JSON（决策还原用）
  slippageEst      Float     @default(0) // 开仓滑点估算（USDT）
  status           String    @default("OPEN") // OPEN | CLOSED
  exitReason       String? // TREND_ENDED | REVERSE_CONFIRMED | LIQUIDATED | MANUAL
  exitSignalJson   String? // 平仓时最后有效趋势信号 JSON
  netPnlWithSlip   Float? // 含滑点估算的净盈亏（页面统计主口径，更保守）
  openDecisionAt   DateTime?
  closedAt         DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([trendCycleId])
  @@index([status])
}

// 幂等决策记录（同一趋势周期同一动作只允许一次；id = 决策键，唯一约束兜底）
model TrendAutoDecision {
  id         String   @id // `{cycleId}:OPEN` / `{cycleId}:CLOSE` 等
  symbol     String
  action     String // OPEN | CLOSE | REVERSE_CLOSE
  cycleId    String
  positionId String?
  detail     String   @default("{}") // 决策上下文（相位/评分/原因）
  createdAt  DateTime @default(now())

  @@index([cycleId])
  @@index([createdAt(sort: Desc)])
}
